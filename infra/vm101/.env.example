# Arada Intelligence OS — VM-101 (Media Services) Environment

# PostgreSQL (VM-100, 10.10.10.100)
DB_PASSWORD=change-me-to-strong-password

# MinIO (local)
MINIO_SECRET_KEY=change-me-to-strong-secret-key

# JWT Secret (must match VM-100)
JWT_SECRET_KEY=change-me-to-very-long-random-secret-key-at-least-32-characters

# Optional: Qdrant API key
# QDRANT_API_KEY=qdrant

# Debug mode (false for production)
# DEBUG=false

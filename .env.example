# Database
DB_HOST=postgres
DB_PORT=5432
DB_USER=arada
DB_PASSWORD=your-secure-password-here
DB_NAME=arada
DB_SSLMODE=disable

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# JWT Configuration
JWT_SECRET_KEY=your-super-secret-jwt-key-min-32-chars-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Environment
DEBUG=false
API_TITLE=Arada Intelligence OS
API_VERSION=1.0.0

# CORS
CORS_ORIGINS=["http://localhost:3000", "http://localhost:3001"]

# MinIO
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Qdrant
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# Ollama
OLLAMA_HOST=ollama
OLLAMA_PORT=11434

# Email (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Email Service (smtp | sendgrid | console)
EMAIL_PROVIDER=console
EMAIL_FROM=noreply@arada.fun
FRONTEND_URL=https://arada.fun
SENDGRID_API_KEY=

# RSS Fetcher
RSS_FETCH_INTERVAL_MINUTES=15
RSS_FETCH_TIMEOUT_SECONDS=30
RSS_BATCH_SIZE=20
RSS_ERROR_THRESHOLD=5
RSS_SLOW_FETCH_ALERT_SECONDS=5

# Telegram Bot
TELEGRAM_BOT_TOKEN=123456:ABC-your-botfather-token
TELEGRAM_WEBHOOK_SECRET=generate-with-openssl-rand-hex-32
TELEGRAM_SUBMIT_LIMIT_PER_HOUR=10

# Stripe Billing
STRIPE_SECRET_KEY=sk_test_your-key
STRIPE_WEBHOOK_SECRET=whsec_from-stripe-dashboard
STRIPE_PRICE_PRO=price_xxx_pro_29_monthly

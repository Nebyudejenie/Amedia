# Arada Intelligence OS — Environment Configuration

# Database (PostgreSQL)
DB_PASSWORD=change-me-to-strong-password

# MinIO S3-compatible storage
MINIO_SECRET_KEY=change-me-to-strong-secret-key

# JWT Secret (min 32 chars)
JWT_SECRET_KEY=change-me-to-very-long-random-secret-key-at-least-32-characters-for-security

# Optional: Qdrant API key
# QDRANT_API_KEY=qdrant-api-key

# Optional: Enable debug mode (false for production)
# DEBUG=false
